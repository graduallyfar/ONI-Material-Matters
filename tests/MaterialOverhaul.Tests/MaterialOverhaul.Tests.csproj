<Project Sdk="Microsoft.NET.Sdk">

  <!-- 复用主工程的本地游戏路径配置（GameDir 定义在 MaterialOverhaul\local.props） -->
  <Import Project="..\..\MaterialOverhaul\local.props" Condition="Exists('..\..\MaterialOverhaul\local.props')" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MaterialOverhaul.Tests</AssemblyName>
    <RootNamespace>MaterialOverhaul.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath>..\..\_build\tests\</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <ManagedDir Condition="'$(GameDir)' != ''">$(GameDir)\OxygenNotIncluded_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\..\MaterialOverhaul\Game\ContentRegistration.cs" Link="Linked\Game\ContentRegistration.cs" />
    <Compile Include="..\..\MaterialOverhaul\Game\MaterialOverhaulFab.Balance.cs" Link="Linked\Game\MaterialOverhaulFab.Balance.cs" />
    <!-- 操作任务门控与加热滑条接口用游戏替身运行实际接入源码；不加载 Unity 或游戏程序集。 -->
    <Compile Include="..\..\MaterialOverhaul\Game\MaterialOverhaulFab.Chores.cs" Link="Linked\Game\MaterialOverhaulFab.Chores.cs" />
    <Compile Include="..\..\MaterialOverhaul\Game\MaterialOverhaulFab.PowerControl.cs" Link="Linked\Game\MaterialOverhaulFab.PowerControl.cs" />
    <Compile Include="..\..\MaterialOverhaul\Game\Patches\OperationChorePatches.cs" Link="Linked\Game\OperationChorePatches.cs" />
    <!-- v0.1.3 数量同步、过热加热保护与伤害补丁的实际源码；只替代游戏对象。 -->
    <Compile Include="..\..\MaterialOverhaul\Game\MaterialOverhaulFab.OrderEditing.cs" Link="Linked\Game\MaterialOverhaulFab.OrderEditing.cs" />
    <Compile Include="..\..\MaterialOverhaul\Game\MaterialOverhaulFab.HeatingSafety.cs" Link="Linked\Game\MaterialOverhaulFab.HeatingSafety.cs" />
    <Compile Include="..\..\MaterialOverhaul\Game\Patches\OrderPatches.cs" Link="Linked\Game\OrderPatches.cs" />
    <Compile Include="..\..\MaterialOverhaul\Game\Patches\RepairPatches.cs" Link="Linked\Game\RepairPatches.cs" />
    <!--
      链接主工程的判断层源码做源码级测试。
      Core\ModLog.cs 被排除：它依赖 UnityEngine.Debug，测试用 ModLogStub.cs 替身，
      这样测试不引游戏程序集、可在纯 .NET 下运行。
      游戏接入层通常不进入本测试工程；上方链接操作任务门控的两份源码与加热滑条接口，
      使用 OperationChoreGameStubs.cs / HeatingPowerControlGameStubs.cs 提供的游戏替身，不替代真实游戏验收。
    -->
    <Compile Include="..\..\MaterialOverhaul\Core\**\*.cs" Exclude="..\..\MaterialOverhaul\Core\ModLog.cs" LinkBase="Linked\Core" />
    <Compile Include="..\..\MaterialOverhaul\Zones\**\*.cs" LinkBase="Linked\Zones" />
    <Compile Include="..\..\MaterialOverhaul\Heating\**\*.cs" LinkBase="Linked\Heating" />
    <Compile Include="..\..\MaterialOverhaul\Hardness\**\*.cs" LinkBase="Linked\Hardness" />
    <Compile Include="..\..\MaterialOverhaul\Orders\**\*.cs" LinkBase="Linked\Orders" />
  </ItemGroup>

</Project>
