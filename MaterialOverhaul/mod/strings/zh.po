msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_LIMITED"
msgid "Best range limited"
msgstr "最佳温区受限"

#. 状态悬停的温区说明行（{0} 本体温度、{1} 建筑下限、{2} 建筑上限、{3} 主建造材料、{4} 配方最佳下限、{5} 配方最佳上限）
#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_DETAIL
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_DETAIL"
msgid "Temperature {0} · working range {1} ~ {2} ({3}) · best range {4} ~ {5}"
msgstr "工作温度：{1} - {2}\n建造材料：{3}\n配方最佳温度：{4} - {5}"

#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_TARGET
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_TARGET"
msgid "Heating target {0}"
msgstr "加热目标：{0}"

#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_TARGET_CAPPED
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_TARGET_CAPPED"
msgid "Heating target {1} (was {0}, capped by the material limit)"
msgstr "加热目标：{1}（原目标：{0}，受建造材料限制）"

#. V0.1.2：不可达时的完整说明（{0} 配方最佳下限、{1} 建筑上限）
#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_UNREACHABLE_DETAIL
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_UNREACHABLE_DETAIL"
msgid "Control mode needs a best-range minimum of {0}, but the building limit is only {1}: no usable band, so heating stops at the limit and production stays paused without skipping the order. Use the default mode or a material with a higher melting point."
msgstr "配方的最佳温度至少为{0}，但建造材料的工作上限为{1}。\n未启用强制运行时，控制模式无法生产，加热到上限后停止。\n可改用默认模式，或换用熔点更高的建造材料。"

#. V0.1.2：受限时的完整说明（{0}B₁、{1}可用上限、{2}B₂、{3}L、{4}U）
#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_LIMITED_DETAIL
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_LIMITED_DETAIL"
msgid "Control mode can use {0} ~ {1} (capped by the material limit; best range maximum {2}); default mode still produces across {3} ~ {4} at reduced efficiency."
msgstr "控制模式的可用温度：{0} - {1}（配方最佳上限：{2}）\n建造材料无法支持整个最佳温区；强制运行可以越过这个限制。\n默认模式仍可在{3} - {4}内生产。"

#. V0.1.2：独立温区限制状态项（不冒充损坏）
#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.ZONELIMIT.NAME
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.ZONELIMIT.NAME"
msgid "Temperature band limited"
msgstr "温区受限"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.ZONELIMIT.TOOLTIP
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.ZONELIMIT.TOOLTIP"
msgid "The recipe best range exceeds the building's usable range; the limit applies to control mode. Default mode still produces at reduced efficiency, and forced run may work past the limit."
msgstr "配方的最佳温区超出建造材料的工作范围。\n使用控制模式时，需限制在重合的温区内，或启用强制运行。"

#. 「允许／暂停生产」自动化输入端口（复用原版逻辑控制端口，由本 Mod 改写说明文本）
#. STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.PRODUCTION_CONTROL.DESCRIPTION
msgctxt "STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.PRODUCTION_CONTROL.DESCRIPTION"
msgid "Allow / Pause Production"
msgstr "生产控制"

#. STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.PRODUCTION_CONTROL.ACTIVE
msgctxt "STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.PRODUCTION_CONTROL.ACTIVE"
msgid "Green: production allowed (materials, power and start conditions still required); unconnected defaults to allowed"
msgstr "<b><style=\"logic_on\">绿色信号</style></b>：允许生产。\n仍需满足这个建筑的其他运行条件。未连接自动化线时允许生产。"

#. STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.PRODUCTION_CONTROL.INACTIVE
msgctxt "STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.PRODUCTION_CONTROL.INACTIVE"
msgid "Red: production paused; recipe preparation, preheating and top-up heating are unaffected"
msgstr "<b><style=\"logic_off\">红色信号</style></b>：暂停生产。\n仍会准备当前配方；如有内置加热，预热和维持温度不受影响。"


#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.DEFAULT
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.DEFAULT"
msgid "Default mode"
msgstr "默认模式"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.CONTROL
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.CONTROL"
msgid "Control mode"
msgstr "控制模式"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.PENDING
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.PENDING"
msgid "Waiting for automation"
msgstr "等待自动化连接"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.DEFAULT_TOOLTIP
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.DEFAULT_TOOLTIP"
msgid "Output port unconnected: produces across the whole working band. Input wiring and signal colours do not select the mode."
msgstr "这个建筑可以在工作温区内生产。\n连接温区信号输出后切换为控制模式。"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.CONTROL_TOOLTIP
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.CONTROL_TOOLTIP"
msgid "Output port connected: produces only inside the best range. Signal colours do not select the mode; green does not mean producing."
msgstr "这个建筑只在工作温区内的配方最佳温区中生产。\n断开温区信号输出后切换为默认模式。"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.PENDING_TOOLTIP
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.PENDING_TOOLTIP"
msgid "Automation network not ready: stored mode and temperature hysteresis are kept; no production or heating yet."
msgstr "正在确认温区信号输出的连接状态。\n确认前暂不生产或加热。"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.FORCED
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.FORCED"
msgid "强制运行已开启"
msgstr "强制运行"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.FORCED_TOOLTIP
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.FORCED_TOOLTIP"
msgid "Overrides the temperature stop; after overheat damage built-in heating stops until fully repaired. Turning it off re-evaluates from the current wiring. Materials, power, automation permission, labour and building health are still required."
msgstr "强制运行允许这个建筑忽略温区限制继续生产，并持续加热。\n因过热受损后，内置加热会停止，完全修复后恢复。\n自动化信号仍能暂停生产。"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.WEARRISK.NAME
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.WEARRISK.NAME"
msgid "机械磨损风险"
msgstr "硬度不足"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.WEARRISK.TOOLTIP
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.WEARRISK.TOOLTIP"
msgid "Hardness is short: actual production accumulates mechanical wear. Preheating, idle time and pausing do not."
msgstr "建造材料的硬度低于要求。\n工作时会损失生命值，预热和待机时不会磨损。"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.HEATRISK.NAME
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.HEATRISK.NAME"
msgid "超过过热阈值"
msgstr "过热"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.HEATRISK.TOOLTIP
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.HEATRISK.TOOLTIP"
msgid "Above the overheat threshold: damage risk. Stopping on temperature gives no heat protection."
msgstr "建筑温度已超过过热温度，可能受到过热损伤。\n停止生产无法阻止环境热量造成的损伤。"

#. 配置卡：配方下方的共用加热功率滑条
msgctxt "STRINGS.UI.UISIDESCREENS.MATERIALOVERHAUL.HEATING_POWER.TITLE"
msgid "Heating Power"
msgstr "加热功率"

msgctxt "STRINGS.UI.UISIDESCREENS.MATERIALOVERHAUL.HEATING_POWER.TOOLTIP"
msgid "{0} W: shared by preheating, top-up and forced sustained heating (20-4000 W). Production power is separate; total draw is the sum. Stored per building."
msgstr "内置加热耗电：<b>{0} W</b>\n用于预热、维持温度和强制运行时的持续加热。\n生产耗电另计。"

msgctxt "STRINGS.UI.USERMENUACTIONS.MATERIALOVERHAUL.FORCEDRUN.TOOLTIP_NO_HEATING"
msgid "解除温区停机限制；本建筑无内置加热，升温依靠生产自热或外部热源。原料、供电、自动化许可与建筑完好仍需满足。"
msgstr "允许这个建筑忽略温区限制继续生产。\n这个建筑没有内置加热，需要依靠生产热量或外部热源升温。\n仍需满足这个建筑的材料和运行条件，自动化信号仍能暂停生产。"

msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNMODE.FORCED_NO_HEATING_TOOLTIP"
msgid "覆盖温区停机限制；本建筑无内置加热，升温依靠生产自热或外部热源。关闭后按当时接线重判；材料、供电、自动化许可、操作与建筑完好仍需满足。"
msgstr "强制运行允许这个建筑忽略温区限制继续生产。\n没有内置加热，需要依靠生产热量或外部热源升温。\n自动化信号仍能暂停生产。"

msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_START"
msgid "启动温度 {0}（无内置加热）"
msgstr "启动温度：{0}\n这个建筑没有内置加热。"

msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_START_CAPPED"
msgid "启动温度 {1}（原 {0}，受建材上限限制；无内置加热）"
msgstr "启动温度：{1}（原目标：{0}，受建造材料限制）\n这个建筑没有内置加热。"

msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_UNREACHABLE_NO_HEATING"
msgid "控制模式需要最佳下限 {0}，但建筑上限只有 {1}：无可用温区，暂停生产，不自动跳单。本建筑无内置加热。改用默认模式或熔点更高的建材。"
msgstr "配方的最佳温度至少为{0}，但建造材料的工作上限为{1}。\n未启用强制运行时，控制模式无法生产。\n可改用默认模式，或换用熔点更高的建造材料。"

msgctxt "STRINGS.UI.UISIDESCREENS.MATERIALOVERHAUL.RECIPE_TEMP_RANGE_TOOLTIP"
msgid "建筑温度处于这个范围时，配方的温度效率为100%。\n实际生产速度还受复制人的操作能力影响。"
msgstr "建筑温度处于这个范围时，配方的温度效率为100%。\n实际生产速度还受复制人的操作能力影响。"

msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.OVERHEAT.HEATING_STOPPED_TOOLTIP"
msgid "内置加热已停止，完全修复后才能恢复。"
msgstr "内置加热已停止，完全修复后才能恢复。"

#. 原版免疫过热建筑的工作范围说明
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.TEMPZONE_IMMUNE_TOOLTIP"
msgid "Working range for buildings with vanilla overheat immunity"
msgstr "这个建筑正常生产所需的温度范围。\n最低温度由建筑类型决定，最高温度按主材料熔点的75%及材料百分比修正计算。\n保留原版过热豁免，越过工作上限不会造成过热伤害；材料相变仍按原版处理。\n没有内置加热，各配方的最佳温度见配方详情。"

#. 非批次工业建筑：工艺最佳温区（建筑效果区）
#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.PROCESS_BEST
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.PROCESS_BEST"
msgid "Process temperature: {0} - {1}"
msgstr "最佳<link=\"HEAT\">温度</link>：{0} - {1}"

#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.PROCESS_BEST_TOOLTIP
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.PROCESS_BEST_TOOLTIP"
msgid "Inside this range the temperature efficiency is 100%. Temperature efficiency scales the throughput per second; vanilla conditions still apply."
msgstr "建筑本体处于此范围时温度效率为100%。\n温度效率影响每秒处理量，实际运行仍需满足原版条件。"

#. 非批次工业建筑：状态栏温度／效率／功率
#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.INDUSTRIAL_STATUS
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.INDUSTRIAL_STATUS"
msgid "Building temperature: {0}\nTemperature efficiency: {1}\nPower: {2} (demand: {3})"
msgstr "建筑温度：{0}\n温度效率：{1}\n耗电：{2}（需求：{3}）"

#. 发电机：额定值与温度修正后的当前发电量分栏显示
#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.GENERATION_STATUS
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.GENERATION_STATUS"
msgid "Rated generation: {0} · Current generation: {1}"
msgstr "额定发电：{0} · 当前发电：{1}"

#. 保留原版过热豁免建筑的工作范围说明
#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.IMMUNE_HEATING_TOOLTIP
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.IMMUNE_HEATING_TOOLTIP"
msgid "The main construction material sets the working ceiling; vanilla overheat immunity is kept, so no overheat damage. Built-in heating still obeys the working range, power and run conditions. Materials can still change phase."
msgstr "主建造材料决定最高工作温度；保留原版过热豁免，不产生过热伤害。\n内置加热仍受工作温区、供电和运行条件限制。材料仍可发生相变。"

#. 非批次工业建筑的温区输出端口说明
#. STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.TEMPERATURE_ZONE.INDUSTRIAL_ACTIVE
msgctxt "STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.TEMPERATURE_ZONE.INDUSTRIAL_ACTIVE"
msgid "Green when a conversion, generation or scrubbing task has its inputs ready and the building is inside its best range. Wiring this output selects control mode; the signal only reports temperature, not that it is producing."
msgstr "存在原料齐备的加工、发电或清洗任务，且建筑温度处于其最佳温区时，输出<b><style=\"logic_on\">绿色信号</style></b>。\n连接这个输出后使用控制模式；信号只表示温度，不保证正在生产。"

#. STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.TEMPERATURE_ZONE.INDUSTRIAL_INACTIVE
msgctxt "STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.TEMPERATURE_ZONE.INDUSTRIAL_INACTIVE"
msgid "Red when there is no runnable process, fuel or scrubbing task, or the temperature is outside the best range. Control mode is off while this output stays unwired."
msgstr "没有可执行工艺、燃料或清洗任务，或温度不在最佳温区时，输出<b><style=\"logic_off\">红色信号</style></b>。\n未连接这个输出时使用默认模式。"
