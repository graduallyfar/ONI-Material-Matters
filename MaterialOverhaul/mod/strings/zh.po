msgctxt "STRINGS.ROOMS.MATERIALOVERHAUL.BEACH_PARADISE.NAME"
msgid "BEACH_PARADISE.NAME"
msgstr "海滨乐园"

msgctxt "STRINGS.ROOMS.MATERIALOVERHAUL.BEACH_PARADISE.DESC"
