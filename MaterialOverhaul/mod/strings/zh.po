msgid "Material Overhaul: built-in heating"
msgstr "材料革新：内置加热"

#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.HARDNESS_NONE
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.HARDNESS_NONE"
msgid "Primary construction material {0}, hit points {1}; no hardness requirement is registered, so there is no mechanical wear."
msgstr "主建造材料 {0}，生命值 {1}；该建筑未登记要求硬度，不产生机械磨损。"

#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.HARDNESS_OK
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.HARDNESS_OK"
msgid "Primary construction material {0}, hardness {1}/{2}, hit points {3}; hardness is sufficient, mechanical wear is zero."
msgstr "主建造材料 {0}，硬度 {1}/{2}，生命值 {3}；硬度合格，机械磨损为零。"

#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.HARDNESS_WEAK
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.HARDNESS_WEAK"
msgid "Primary construction material {0}, hardness {1}/{2}, hit points {3}; hardness is insufficient, so wear accrues with actual production time ({4} wear units/s, {5} HP per wear unit)."
msgstr "主建造材料 {0}，硬度 {1}/{2}，生命值 {3}；硬度不足，按实际生产时间磨损（{4} 磨损单位/生产秒，{5} HP/磨损单位）。"

