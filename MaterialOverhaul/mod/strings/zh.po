#. 建筑面板：强制运行开关
#. STRINGS.UI.USERMENUACTIONS.MATERIALOVERHAUL.FORCEDRUN.ENABLE
msgctxt "STRINGS.UI.USERMENUACTIONS.MATERIALOVERHAUL.FORCEDRUN.ENABLE"
msgid "Enable Forced Run"
msgstr "开启强制运行"

#. STRINGS.UI.USERMENUACTIONS.MATERIALOVERHAUL.FORCEDRUN.DISABLE
msgctxt "STRINGS.UI.USERMENUACTIONS.MATERIALOVERHAUL.FORCEDRUN.DISABLE"
msgid "Disable Forced Run"
msgstr "关闭强制运行"

#. STRINGS.UI.USERMENUACTIONS.MATERIALOVERHAUL.FORCEDRUN.TOOLTIP_ENABLE
msgctxt "STRINGS.UI.USERMENUACTIONS.MATERIALOVERHAUL.FORCEDRUN.TOOLTIP_ENABLE"
msgid "Keeps producing past the working range and keeps heating; materials, power, automation permission and building health are still required."
msgstr "不因温区越界停产，并持续加热；原料、供电、自动化许可与建筑完好仍需满足。"

#. STRINGS.UI.USERMENUACTIONS.MATERIALOVERHAUL.FORCEDRUN.TOOLTIP_DISABLE
msgctxt "STRINGS.UI.USERMENUACTIONS.MATERIALOVERHAUL.FORCEDRUN.TOOLTIP_DISABLE"
msgid "Turning it off re-evaluates production permission from the output port wiring at that moment and keeps the current batch."
msgstr "关闭后按输出端口当时的接线重判生产许可，保留当前批次。"

#. 机械磨损的伤害来源
#. STRINGS.BUILDINGS.DAMAGESOURCES.MATERIALOVERHAUL.MECHANICAL_WEAR
msgctxt "STRINGS.BUILDINGS.DAMAGESOURCES.MATERIALOVERHAUL.MECHANICAL_WEAR"
msgid "Mechanical Wear"
msgstr "机械磨损"

#. 损坏原因状态项：只有机械损坏
#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.MECHANICAL.NAME
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.MECHANICAL.NAME"
msgid "Mechanical Damage"
msgstr "机械损坏"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.MECHANICAL.TOOLTIP
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.MECHANICAL.TOOLTIP"
msgid "Hardness is short, so wear from production time caused the damage; repair uses the normal route and does not reset temperature."
msgstr "硬度不足，按生产时间累计磨损导致损坏；维修不重置温度。"

#. 损坏原因状态项：只有过热损坏
#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.OVERHEAT.NAME
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.OVERHEAT.NAME"
msgid "Overheat Damage"
msgstr "过热损坏"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.OVERHEAT.TOOLTIP
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.OVERHEAT.TOOLTIP"
msgid "Body temperature above the overheat threshold caused the damage; built-in heating has stopped and resumes after full repair, which resets temperature."
msgstr "超过过热阈值导致损坏；内置加热已停止，完全维修后解除，维修重置温度。"

#. 损坏原因状态项：机械与过热同时存在
#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.BOTH.NAME
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.BOTH.NAME"
msgid "Mechanical + Overheat Damage"
msgstr "机械损坏＋过热损坏"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.BOTH.TOOLTIP
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.BOTH.TOOLTIP"
msgid "Mechanical wear and overheat damage are both present; built-in heating has stopped and resumes after full repair. Repair follows the overheat route and resets temperature, without extra mechanical damage."
msgstr "同时存在机械磨损与过热损坏；内置加热已停止，完全维修后解除。维修按过热方式处理并重置温度，不会额外多扣一份机械伤害。"

#. 逻辑端口：温区输出信号
#. STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.TEMPERATURE_ZONE.DESCRIPTION
msgctxt "STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.TEMPERATURE_ZONE.DESCRIPTION"
msgid "Temperature Zone Signal"
msgstr "温区信号"

#. STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.TEMPERATURE_ZONE.ACTIVE
msgctxt "STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.TEMPERATURE_ZONE.ACTIVE"
msgid "Recipe locked and temperature inside its best range; wiring selects control mode, and green does not mean producing."
msgstr "已锁定配方且温度在最佳温区；接线即控制模式，绿色不代表正在生产。"

#. STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.TEMPERATURE_ZONE.INACTIVE
msgctxt "STRINGS.BUILDING.LOGICPORTS.MATERIALOVERHAUL.TEMPERATURE_ZONE.INACTIVE"
msgid "No locked recipe, or temperature outside the best range; unconnected wiring selects the default mode."
msgstr "未锁定配方或温度不在最佳温区；未接线即默认模式。"

#. 过热温度属性的修正项说明（v0.1.2：最高工作温度 = 过热阈值 = 主建造材料熔点 × 75%）
#. STRINGS.BUILDING.ATTRIBUTES.MATERIALOVERHAUL.OVERHEAT.DESCRIPTION
msgctxt "STRINGS.BUILDING.ATTRIBUTES.MATERIALOVERHAUL.OVERHEAT.DESCRIPTION"
msgid "Maximum working temperature = overheat threshold = 75% of the primary construction material's melting point (in kelvin)"
msgstr "最高工作温度＝过热阈值，取主建造材料熔点的 75%（按 K 计）"

#. 建筑信息卡描述里追加的一句话：工作温区归属（v0.1.2）
#. STRINGS.BUILDINGS.PREFABS.MATERIALOVERHAUL.TEMPZONE_NOTE
msgctxt "STRINGS.BUILDINGS.PREFABS.MATERIALOVERHAUL.TEMPZONE_NOTE"
msgid "Runs on a temperature band: the maximum is 75% of the primary construction material's melting point, and each recipe has its own best range at full efficiency. Wiring the output port selects control mode."
msgstr "按温区运行：上限＝主建造材料熔点 ×75%，配方另有最佳温区并满效率。输出接线＝控制模式。"

#. 配方详情「效果」里的温度行（{0} 最佳温区下限、{1} 最佳温区上限）
#. STRINGS.UI.UISIDESCREENS.MATERIALOVERHAUL.RECIPE_TEMP_RANGE_DETAIL
msgctxt "STRINGS.UI.UISIDESCREENS.MATERIALOVERHAUL.RECIPE_TEMP_RANGE_DETAIL"
msgid "Best temperature range: {0} ~ {1}"
msgstr "最佳温区：{0} ~ {1}"

#. 信息卡里的过热温度行（{0} 过热阈值）
#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.OVERHEAT_LINE
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.OVERHEAT_LINE"
msgid "过热温度：{0}"
msgstr "过热温度：{0}"

#. 过热温度行的提示（{0} 主建造材料名、{1} 材料熔点、{2} 过热阈值／最高工作温度、{3} 致命温度）
#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.OVERHEAT_TOOLTIP
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.OVERHEAT_TOOLTIP"
msgid "Limit = overheat threshold = 75% of {0}'s melting point {1} (in kelvin) = {2}. Above it the default and control modes stop production and built-in heating; only forced run may work past it. Stopping on temperature gives no heat protection. Fatal temperature {3}."
msgstr "上限＝过热阈值＝{0} 熔点 {1} × 75%（按 K 计）= {2}。超过后默认／控制模式停产并停止内置加热，只有强制运行可越界生产。温区停机不提供耐热保护；致命温度 {3}。"

#. 损坏原因状态项：来源未知的旧损伤（迁移）
#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.UNKNOWN.NAME
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.UNKNOWN.NAME"
msgid "Damage (source unknown)"
msgstr "损坏（来源未知）"

#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.UNKNOWN.TOOLTIP
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.UNKNOWN.TOOLTIP"
msgid "Damage from an older save that did not record its source; vanilla repair temperature behaviour is kept and it is not treated as pure mechanical damage."
msgstr "损伤来自旧存档，当时未记录来源；保留原版维修温度行为，不当作纯机械损坏。"

