#. 模板只取 {1}{2}{3}{4}{5}{6}，状态文字由状态项标题显示
#. STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNSTATUS.TOOLTIP
msgctxt "STRINGS.BUILDING.STATUSITEMS.MATERIALOVERHAUL.RUNSTATUS.TOOLTIP"
msgid "Temperature {1} · efficiency {2} · batch {6}\nPower {4} (requested {3}) · heat injected {5}"
msgstr "建筑温度：{1}\n温度效率：{2} · 生产进度：{6}\n耗电：{4}（需求：{3}）\n内置加热：{5}"

