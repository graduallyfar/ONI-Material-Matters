msgstr "操作任务"

#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.PRODUCING
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.PRODUCING"
msgid "Producing"
msgstr "生产中"

#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.PRODUCING_LOW
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.PRODUCING_LOW"
msgid "Producing at low efficiency (cold side)"
msgstr "低温生产（效率降低）"

#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.PRODUCING_HIGH
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.PRODUCING_HIGH"
msgid "Producing at low efficiency (hot side)"
msgstr "高温生产（效率降低）"

#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.COOLING
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.COOLING"
msgid "Cooling down"
msgstr "降温中"

#. V0.1.2：需要升温但没有实际注热（不假称为预热中）
#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.WAITING_HEAT
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.WAITING_HEAT"
msgid "Waiting for heat"
msgstr "等待升温"

#. V0.1.2：最佳温区不可达且已停在受限目标
#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.TEMP_LIMITED
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.TEMP_LIMITED"
msgid "Temperature limited - production paused"
msgstr "生产暂停：温区受限"

#. V0.1.2：独立温区限制提示
#. STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_UNREACHABLE
msgctxt "STRINGS.UI.BUILDINGEFFECTS.MATERIALOVERHAUL.STATUS.ZONE_UNREACHABLE"
msgid "Best range unreachable"
msgstr "最佳温区不可达"

